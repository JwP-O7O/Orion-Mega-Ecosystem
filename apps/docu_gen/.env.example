# Environment Configuration Template
# Copy this file to .env and update values for your environment
# Never commit the actual .env file to version control!

# ============================================
# Flask Configuration
# ============================================
# CRITICAL: Generate a secure random key for production
# Use: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# Environment mode (true/false)
FLASK_DEBUG=false

# Server configuration
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_ENV=production

# Application version (for tracking in Sentry)
APP_VERSION=1.0.0

# ============================================
# Database Configuration
# ============================================
# Default is SQLite, but you can configure other databases here
# SQLALCHEMY_DATABASE_URI=sqlite:///docugen.db

# For PostgreSQL (recommended for production):
# SQLALCHEMY_DATABASE_URI=postgresql://user:password@localhost:5432/docugen

# For MySQL:
# SQLALCHEMY_DATABASE_URI=mysql://user:password@localhost/dbname

# ============================================
# Security Configuration
# ============================================
# Session timeout in seconds (default: 3600 = 1 hour)
# SESSION_TIMEOUT=3600

# ============================================
# Error Tracking (Optional)
# ============================================
# Sentry DSN for error tracking (get from https://sentry.io)
# SENTRY_DSN=https://your-sentry-dsn-here

# ============================================
# Production Server (Gunicorn)
# ============================================
# Number of worker processes (default: CPU cores * 2 + 1)
# GUNICORN_WORKERS=4

# ============================================
# Email Configuration (Future Feature)
# ============================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# ============================================
# File Upload Configuration
# ============================================
# Maximum file size for AI generation (in bytes, default: 51200 = 50KB)
# MAX_AI_FILE_SIZE=51200

# ============================================
# Blockchain Configuration (Week 1-2)
# ============================================
# Polygon RPC URL (Mumbai testnet for development, mainnet for production)
# Get free RPC endpoint from: https://www.alchemy.com/ or https://infura.io/
POLYGON_RPC_URL=https://polygon-mumbai.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# Alternative: Polygon mainnet (production only)
# POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# Deployed smart contract address (get this after running deploy.py)
CONTRACT_ADDRESS=0xYourDeployedContractAddressHere

# Deployer private key (CRITICAL: Keep this secret! Never commit to git!)
# Generate with: python -c "from eth_account import Account; acc = Account.create(); print(f'Address: {acc.address}\\nPrivate Key: {acc.key.hex()}')"
DEPLOYER_PRIVATE_KEY=0xYourPrivateKeyHere

# Mumbai testnet chain ID (80001) or Mainnet chain ID (137)
POLYGON_CHAIN_ID=80001

# ============================================
# IPFS Configuration (Week 3-4)
# ============================================
# Pinata API credentials for IPFS storage
# Sign up at: https://pinata.cloud/ (Free tier: 1GB storage)
PINATA_API_KEY=your-pinata-api-key-here
PINATA_SECRET_KEY=your-pinata-secret-api-key-here

# Alternative IPFS gateway (optional)
# IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs/

# ============================================
# Document Encryption (Week 3-4)
# ============================================
# AES-256 encryption key for document storage (32 bytes = 64 hex chars)
# CRITICAL: Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Store securely in production (use AWS KMS, HashiCorp Vault, etc.)
DOCUMENT_ENCRYPTION_KEY=your-32-byte-hex-encryption-key-here-must-be-64-chars

# ============================================
# Zero-Knowledge Proof Configuration (Week 5-6)
# ============================================
# ZKP circuit directory (default: zkp/circuits)
# ZKP_CIRCUIT_DIR=zkp/circuits

# ZKP proving keys directory (default: zkp/keys)
# ZKP_KEYS_DIR=zkp/keys

# Enable ZKP features (true/false)
# ZKP_ENABLED=true
